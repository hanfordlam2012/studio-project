<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= student.fName %>'s Progress Summary</title><style>body{color:#19303a;font:14px/1.55 Arial,sans-serif;margin:0}.toolbar{background:#15364c;color:#fff;display:flex;justify-content:space-between;padding:12px 18px}.toolbar button{background:#f2c94c;border:0;font-weight:bold;padding:9px 13px}.sheet{margin:auto;max-width:850px;padding:35px}.kicker{color:#087f76;font-size:11px;font-weight:bold;text-transform:uppercase}h1{font-size:34px;margin:5px 0}.summary{border-block:1px solid #ccd6d3;display:flex;gap:30px;margin:18px 0 28px;padding:12px 0}.path{break-inside:avoid;border-top:2px solid #15364c;padding:18px 0}.path time{color:#63747a;font-size:12px}.path h2{margin:4px 0 10px}.notes h1,.notes h2,.notes h3{font-size:17px}.response{background:#eef6f3;border-left:4px solid #087f76;padding:10px 12px}.question{background:#fff8dc;border-left:4px solid #f2c94c;padding:10px 12px}@media print{.toolbar{display:none}.sheet{max-width:none;padding:0}}</style></head><body><header class="toolbar"><span>Printable student progress summary</span><button onclick="window.print()">Print / Save PDF</button></header><main class="sheet"><div class="kicker">Music Learning Studio · generated <%= generatedAt.toLocaleDateString('en-AU') %></div><h1><%= student.fName %> <%= student.lName %></h1><div class="summary"><strong><%= student.lessonCount || 0 %> lessons used</strong><strong><%= student.leaderboardScore || 0 %> points</strong><strong><%= weeks.length %> published paths</strong></div><% weeks.forEach(function(week){ %><article class="path"><time><%= new Date(week.createdDate).toLocaleDateString('en-AU',{day:'numeric',month:'long',year:'numeric'}) %></time><h2><%= week.pieceName || 'Lesson path' %></h2><div class="notes"><%- displayPathHTML(week.comments || '') %></div><% if(week.practiceResponse&&(week.practiceResponse.items||[]).length){ %><div class="response"><strong>Practice update</strong><ul><% week.practiceResponse.items.forEach(function(item){ %><li><%= item.label || 'Practice task' %>: <%= item.status %></li><% }) %></ul></div><% if(week.practiceResponse.question){ %><p class="question"><strong>Student question:</strong> <%= week.practiceResponse.question %></p><% } %><% } %></article><% }) %></main></body></html>
