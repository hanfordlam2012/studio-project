<!doctype html>
<html lang="en" id="missions-html">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width">
  <meta name="theme-color" content="#122e44"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="Music Studio"><link rel="manifest" href="/manifest.webmanifest"><link rel="apple-touch-icon" href="/favicon.png">
  <link rel="shortcut icon" href="favicon.png" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins&family=Recursive&family=Belgrano&family=Bellota&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles/style.css?v=23">
  <title>Trophy Cabinet | Learning Park Portal</title>
  <style>HTML,BODY{cursor:url("../../images/cursor.cur"),auto;}</style>
</head>
<body class="portal-body portal-body-cabinet">
  <%- include('includes/portalHeader', {activePortalTab: 'missions'}) %>
  <main class="portal-main">
    <% adErrors.forEach(function(message) { %><div class="alert alert-danger text-center"><%= message %></div><% }) %>
    <% missionErrors.forEach(function(message) { %><div class="alert alert-danger text-center"><%= message %></div><% }) %>
    <% missionStatus.forEach(function(message) { %><div class="alert alert-success text-center"><%= message %></div><% }) %>
    <%- include('includes/portalStatus') %>
    <section class="portal-intro">
      <p class="portal-eyebrow">Trophy Cabinet</p>
      <h1>The work that became yours</h1>
      <p>Finished pieces, performances and milestones live here as evidence of attention accumulated over time.</p>
    </section>
    <section class="quaver-mission" id="quaver-attack">
      <div class="quaver-copy">
        <p class="portal-eyebrow">Game mission · 100-point bounty</p>
        <h2>Quaver Attack</h2>
        <p>Reach the end and enter the code revealed on the final screen. Complete the bounty once; replay the game whenever you like.</p>
        <% if(quaverCompletedAt){ %><div class="quaver-complete"><strong>Mission completed</strong><span><%= new Date(quaverCompletedAt).toLocaleDateString('en-AU',{day:'numeric',month:'long',year:'numeric'}) %> · 100 points awarded</span></div><% } %>
        <button class="portal-button portal-button-primary" type="button" data-quaver-launch><%= quaverCompletedAt ? 'Replay Quaver Attack' : 'Enter Quaver Attack' %></button>
        <% if(!quaverCompletedAt){ %><form class="quaver-code" action="/missions/quaver-attack/claim" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="completionCode">Code from the final screen</label><div><input id="completionCode" name="completionCode" maxlength="80" autocomplete="off" required <%= quaverCodeReady ? '' : 'disabled' %>><button type="submit" <%= quaverCodeReady ? '' : 'disabled' %>>Claim 100 points</button></div><small><%= quaverCodeReady ? 'The code is checked securely and can award this bounty only once.' : 'Code claiming is awaiting studio setup.' %></small></form><% } %>
      </div>
      <div class="quaver-cabinet" data-quaver-cabinet hidden><div class="quaver-loading">Quaver Attack is ready to load.</div><iframe title="Quaver Attack music game" data-quaver-frame data-src="/files/QuaverAttack/index.html?v=2" allow="fullscreen" scrolling="no" loading="lazy"></iframe><div class="quaver-controls"><button type="button" data-quaver-restart>Restart game</button><button type="button" data-quaver-close>Close game</button></div></div>
    </section>
    <div class="portal-achievement-grid">
      <section class="portal-achievement-section">
        <div class="portal-section-heading">
          <div><p class="portal-eyebrow">Repertoire</p><h2>Polished Pieces</h2></div>
          <span class="portal-count"><%= repertoirePolished.length %></span>
        </div>
        <div class="portal-achievement-list">
          <% repertoirePolished.forEach((rep,index) => { %>
            <article class="portal-achievement"><span><%= String(index + 1).padStart(2, '0') %></span><div><%- rep %></div></article>
          <% }) %>
          <% if (!repertoirePolished.length) { %><div class="portal-empty-state"><span>The first polished piece will appear here.</span></div><% } %>
        </div>
      </section>
      <section class="portal-achievement-section">
        <div class="portal-section-heading">
          <div><p class="portal-eyebrow">Public moments</p><h2>Performances and Exams</h2></div>
          <span class="portal-count"><%= missionsAccomplished.length %></span>
        </div>
        <div class="portal-achievement-list">
          <% missionsAccomplished.forEach((mission,index) => { %>
            <article class="portal-achievement is-performance"><span><%= String(index + 1).padStart(2, '0') %></span><div><%- mission %></div></article>
          <% }) %>
          <% if (!missionsAccomplished.length) { %><div class="portal-empty-state"><span>Future performances and exams will gather here.</span></div><% } %>
        </div>
      </section>
    </div>
  </main>
  <footer class="portal-footer">Learning Park Portal · <a href="/">Return to hanfordlam.com</a></footer>
  <script>(function(){var cabinet=document.querySelector('[data-quaver-cabinet]'),frame=document.querySelector('[data-quaver-frame]'),launch=document.querySelector('[data-quaver-launch]');function loadGame(){cabinet.hidden=false;if(!frame.src)frame.src=frame.dataset.src;cabinet.scrollIntoView({behavior:'smooth',block:'start'})}launch.addEventListener('click',loadGame);document.querySelector('[data-quaver-restart]').addEventListener('click',function(){frame.src='about:blank';setTimeout(function(){frame.src=frame.dataset.src},50)});document.querySelector('[data-quaver-close]').addEventListener('click',function(){cabinet.hidden=true;launch.focus()})})();</script>
  <script src="/pwa.js" defer></script>
</body>
</html>
