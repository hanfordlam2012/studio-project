<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width">
  <meta name="theme-color" content="#122e44"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="Music Studio"><link rel="manifest" href="/manifest.webmanifest"><link rel="apple-touch-icon" href="/favicon.png">
  <link rel="shortcut icon" href="favicon.png" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins&family=Recursive&family=Belgrano&family=Bellota&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles/style.css?v=24">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <title>Lesson History | Learning Park Portal</title>
  <style>HTML,BODY{cursor:url("../../images/cursor.cur"),auto;}</style>
</head>
<body class="portal-body portal-body-history">
  <%- include('includes/portalHeader', {activePortalTab: 'history'}) %>
  <main class="portal-main">
    <% adErrors.forEach(function(message){ %><div class="alert alert-danger text-center"><%= message %></div><% }) %>
    <%- include('includes/portalStatus', {activePortalTab: 'history'}) %>
    <section class="portal-intro"><p class="portal-eyebrow">Practice Timeline</p><h1>The path behind you</h1><p>Revisit lesson notes alongside the practice updates and questions that followed them.</p></section>
    <section class="history-chart-panel" aria-labelledby="development-chart-title">
      <div class="history-chart-heading"><div><p class="portal-eyebrow">Development over time</p><h2 id="development-chart-title">Five paths through your playing</h2></div><a href="/files/Piano%20Performance%20Development%20Rubric.pdf" target="_blank" rel="noopener noreferrer">Open the rubric</a></div>
      <% if (dateLabels.length > 1) { %><div class="history-chart-wrap"><canvas id="developmentChart" role="img" aria-label="Interactive chart showing pulse, pitch, articulation, dynamics and body feeling scores from one to five over time"></canvas></div><p class="history-chart-note">Select a name in the key to show or hide that path. Hover or tap a point for its lesson score.</p><% } else { %><div class="history-empty">The graph will appear after two development snapshots have been recorded.</div><% } %>
    </section>
    <% const years=[...new Set(studentWeeks.map(function(week){return week.createdDate instanceof Date ? week.createdDate.getFullYear() : new Date(week.createdDate).getFullYear()}))].filter(Boolean); %>
    <section class="history-summary" aria-label="History summary"><div><span>Paths recorded</span><strong><%= studentWeeks.length %></strong></div><div><span>Latest project</span><strong><% if(studentWeeks.length){ const latestPieces=Array.isArray(studentWeeks[0].pieces)?studentWeeks[0].pieces:[]; %><%= studentWeeks[0].pieceName %><%= latestPieces.length>1 ? ' + '+(latestPieces.length-1)+' more' : '' %><% } else { %>Waiting<% } %></strong></div><div><span>Years gathered</span><strong><%= years.length || 0 %></strong></div></section>
    <section class="history-tools" aria-label="Filter lesson history"><label for="historySearch">Search notes<input id="historySearch" type="search" placeholder="Piece, focus, task or observation"></label><label for="historyYear">Year<select id="historyYear"><option value="">All years</option><% years.forEach(function(year){ %><option value="<%= year %>"><%= year %></option><% }) %></select></label></section>
    <section class="history-list" id="historyList">
      <% studentWeeks.forEach(function(week,index){ const created=week.createdDate instanceof Date ? week.createdDate : new Date(week.createdDate); const structured=(Array.isArray(week.pieces)&&week.pieces.length)||(Array.isArray(week.practiceTasks)&&week.practiceTasks.length); const pieceNames=Array.isArray(week.pieces)?week.pieces.map(function(piece){return piece.pieceName}).filter(Boolean):[]; const searchable=[pieceNames.join(' '),week.pieceName,week.lessonFocus,week.quietKnot,week.generalNote,week.comments].join(' ').toLowerCase(); %>
        <details class="history-entry" data-history-entry data-year="<%= created.getFullYear() %>" data-search="<%= searchable %>" <%= index===0?'open':'' %>>
          <summary><span class="history-date"><%= created.toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'}) %></span><span class="history-piece"><strong><%= week.pieceName || 'Untitled path' %><%= pieceNames.length>1 ? ' + '+(pieceNames.length-1)+' more' : '' %></strong><span><%= week.lessonFocus || 'Lesson notes' %></span></span><span class="history-kind <%= structured?'':'is-legacy' %>"><%= structured?'Path':'Legacy' %></span></summary>
          <div class="history-detail"><div class="history-notes"><%- filterUserHTML(week.comments || 'No notes were recorded for this lesson.') %><%- include('includes/pathMaterials', {materials: week.attachments, weekId: week._id}) %></div><aside class="history-evidence"><a class="history-print" href="/parents/print/<%= week._id %>" target="_blank" rel="noopener">Open printable notes</a><div><p class="portal-eyebrow">Development snapshot</p><div class="history-ratings"><% [['rhythm','Pulse'],['coordination','Pitch'],['tone','Articulation'],['dynamics','Dynamics'],['stylistic','Body feeling']].forEach(function(item){ %><div class="history-rating"><span><%= item[1] %></span><strong><%= week[item[0]] || '—' %> / 5</strong></div><% }) %></div></div><% if(week.techAName||week.techBName){ %><div class="history-tech"><p class="portal-eyebrow">Technical work</p><% if(week.techAName){ %><strong><%= week.techAName %></strong><span><%= week.techAScore || 'Not scored' %> / 5</span><% } %><% if(week.techBName){ %><strong><%= week.techBName %></strong><span><%= week.techBScore || 'Not scored' %> / 5</span><% } %></div><% } %></aside></div>
          <% if(week.practiceResponse && (week.practiceResponse.items || []).length){ const responseNames={started:'Started',changed:'Something changed',secure:'Felt secure',help:'Needed help'}; %><section class="history-response"><p class="portal-eyebrow">Your practice update</p><div><% week.practiceResponse.items.forEach(function(item){ %><span><strong><%= responseNames[item.status] || item.status %></strong><%= item.label || 'Practice task' %></span><% }) %></div><% if(week.practiceResponse.question){ %><blockquote><strong>Your question</strong><%= week.practiceResponse.question %></blockquote><% } %></section><% } %>
        </details>
      <% }) %>
      <% if(!studentWeeks.length){ %><div class="history-empty">Lesson paths will gather here after the first one is published.</div><% } %>
    </section>
    <div class="history-empty" id="historyNoResults" hidden>No lesson paths match those filters.</div>
  </main>
  <footer class="portal-footer">Learning Park Portal · <a href="/">Return to hanfordlam.com</a></footer>
  <script>
    (function(){var canvas=document.getElementById('developmentChart');if(!canvas||typeof Chart==='undefined')return;new Chart(canvas,{type:'line',data:{labels:<%- JSON.stringify(dateLabels).replace(/</g,'\\u003c') %>,datasets:[{label:'Pulse',data:<%- JSON.stringify(rhythmArray) %>,borderColor:'#d96c50',backgroundColor:'#d96c50'},{label:'Pitch',data:<%- JSON.stringify(coordinationArray) %>,borderColor:'#2879a8',backgroundColor:'#2879a8'},{label:'Articulation',data:<%- JSON.stringify(toneArray) %>,borderColor:'#a77b00',backgroundColor:'#a77b00'},{label:'Dynamics',data:<%- JSON.stringify(dynamicsArray) %>,borderColor:'#087f76',backgroundColor:'#087f76'},{label:'Body feeling',data:<%- JSON.stringify(stylisticArray) %>,borderColor:'#6e2ab5',backgroundColor:'#6e2ab5'}]},options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},elements:{line:{borderWidth:3,tension:.22},point:{radius:4,hoverRadius:7}},plugins:{legend:{position:'bottom',labels:{boxWidth:12,boxHeight:12,usePointStyle:true,padding:18,font:{family:'Recursive',size:12}}},tooltip:{callbacks:{label:function(context){return context.dataset.label+': '+context.parsed.y+' / 5'}}}},scales:{y:{min:1,max:5,ticks:{stepSize:1,callback:function(value){return value+' / 5'}},grid:{color:'rgba(21,54,76,.11)'}},x:{grid:{display:false}}}}})})();
    document.querySelectorAll('.history-evidence .portal-eyebrow').forEach(function(heading){if(heading.textContent.trim()!=='Development snapshot')return;var link=document.createElement('a');link.className='history-rubric-link';link.href='/files/Piano%20Performance%20Development%20Rubric.pdf';link.target='_blank';link.rel='noopener noreferrer';link.textContent='How to read this snapshot';heading.after(link)});
    (function(){var search=document.getElementById('historySearch'),year=document.getElementById('historyYear'),entries=[].slice.call(document.querySelectorAll('[data-history-entry]')),empty=document.getElementById('historyNoResults');function filter(){var query=search.value.trim().toLowerCase(),chosen=year.value,visible=0;entries.forEach(function(entry){var show=(!query||entry.dataset.search.indexOf(query)>-1)&&(!chosen||entry.dataset.year===chosen);entry.hidden=!show;if(show)visible++});empty.hidden=visible!==0}search.addEventListener('input',filter);year.addEventListener('change',filter)}());
  </script>
  <script src="/pwa.js" defer></script>
</body></html>
