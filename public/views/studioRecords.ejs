<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Studio Records | Music Learning Studio</title><link rel="shortcut icon" href="/favicon.png"><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600;700&family=Rye&display=swap" rel="stylesheet"><style>
:root{--ink:#19303a;--muted:#63747a;--paper:#f7f4ec;--line:#d8ddd8;--teal:#087f76;--yellow:#f2c94c;--navy:#15364c}*{box-sizing:border-box}body{background:var(--paper);color:var(--ink);font-family:"DM Sans",sans-serif;margin:0}.top{background:var(--navy);color:#fff}.top-inner{align-items:center;display:flex;gap:18px;justify-content:space-between;margin:auto;max-width:1180px;min-height:72px;padding:14px 24px}.brand{color:#fff;font-family:Rye,serif;text-decoration:none}.nav{display:flex;gap:6px;overflow:auto}.nav a{color:#dce9ed;padding:8px 10px;text-decoration:none;white-space:nowrap}.nav a.active{background:var(--yellow);color:var(--navy)}main{margin:auto;max-width:1180px;padding:44px 24px 80px}.eyebrow{color:var(--teal);font-size:12px;font-weight:700;text-transform:uppercase}h1{font-family:Rye,serif;font-size:clamp(36px,6vw,64px);font-weight:400;margin:7px 0 30px}.tabs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px}.tabs button{background:#fff;border:1px solid var(--navy);color:var(--navy);cursor:pointer;font-weight:700;padding:9px 12px}.tabs button.active{background:var(--navy);color:#fff}.record-panel[hidden]{display:none}.tools{align-items:end;display:grid;gap:12px;grid-template-columns:minmax(0,1fr) minmax(180px,.35fr);margin-bottom:14px}.tools input,.tools select{background:#fff;border:1px solid #aebbb8;padding:10px 12px;width:100%}.list{background:#fff;border:1px solid var(--line);display:grid}.row{align-items:center;border-bottom:1px solid var(--line);display:grid;gap:14px;grid-template-columns:minmax(180px,1fr) minmax(160px,.7fr) auto;padding:14px 16px}.row:last-child{border:0}.row strong,.row small{display:block;overflow-wrap:anywhere}.row small{color:var(--muted)}.row a,.record-action{background:var(--navy);border:0;color:#fff;cursor:pointer;font-size:12px;font-weight:700;padding:8px 10px;text-decoration:none}.activity{grid-template-columns:130px minmax(150px,.6fr) minmax(220px,1fr)}.empty{background:#fff;border-left:5px solid var(--yellow);padding:20px}.backup-note{background:#fff8dc;border-left:5px solid var(--yellow);line-height:1.6;padding:18px}.backup-grid,.health-grid{display:grid;gap:18px;grid-template-columns:repeat(2,minmax(0,1fr))}.backup-card,.health-card{background:#fff;border:1px solid var(--line);padding:22px}.backup-card label,.queue-form label{display:block;font-weight:700;margin:16px 0 6px}.backup-card input,.queue-form input{border:1px solid #9eadaa;font:inherit;max-width:100%;padding:11px 12px;width:100%}.backup-card button{background:var(--navy);border:0;color:#fff;cursor:pointer;font:inherit;font-weight:700;margin-top:18px;padding:11px 14px}.backup-card p{color:var(--muted);line-height:1.55}.record-notice{border-left:5px solid var(--teal);margin-bottom:16px;padding:13px 16px}.record-notice.success{background:#e8f7f2}.record-notice.error{background:#fff0ea;border-color:#c74f2c}.status{display:inline-block;font-size:11px;font-weight:800;padding:5px 7px;text-transform:uppercase}.status-sent,.status-working{background:#dff4e8;color:#17663f}.status-failed,.status-attention{background:#ffe3da;color:#9b3219}.status-pending,.status-sending,.status-configured{background:#fff0bd;color:#705500}.status-not-sent{background:#e9edef;color:#42545b}.delivery-row{grid-template-columns:minmax(180px,1fr) minmax(210px,1fr) auto}.queue-row{align-items:start;grid-template-columns:minmax(180px,1fr) minmax(260px,.8fr) auto}.queue-form{align-items:end;display:flex;gap:8px}.queue-form label{margin:0}.queue-form button{white-space:nowrap}.health-card{border-top:5px solid var(--teal)}.health-card.attention{border-color:#c74f2c}.health-card.configured{border-color:var(--yellow)}.health-card p{color:var(--muted);margin-bottom:0}.section-intro{color:var(--muted);margin-top:-8px}h2{margin-top:0}@media(max-width:700px){.top-inner{align-items:flex-start;flex-direction:column}.tools,.row,.activity,.delivery-row,.queue-row,.backup-grid,.health-grid{grid-template-columns:1fr}.queue-form{align-items:stretch;flex-direction:column}.tabs{flex-wrap:nowrap;overflow:auto}}
</style></head><body><%- include('includes/adminNav', {currentPage: 'records'}) %><main><div class="eyebrow">Private administration</div><h1>Studio Records</h1><% recordErrors.forEach(function(message){ %><div class="record-notice error" role="alert"><%= message %></div><% }) %><% operationStatus.forEach(function(message){ %><div class="record-notice success" role="status"><%= message %></div><% }) %><div class="tabs" role="tablist"><button class="active" data-tab="reports">Student reports</button><button data-tab="deliveries">Email delivery</button><button data-tab="scheduled">Scheduled paths</button><button data-tab="materials">Materials</button><button data-tab="activity">Activity</button><button data-tab="health">Health check</button><button data-tab="backup">Backup</button></div>
<section class="record-panel" data-panel="reports"><h2>Printable progress summaries</h2><div class="tools"><input type="search" data-filter="reports" placeholder="Find a student"><span></span></div><div class="list" data-list="reports"><% students.forEach(function(student){ %><article class="row" data-search="<%= (student.fName+' '+student.lName).toLowerCase() %>"><div><strong><%= student.fName %> <%= student.lName %></strong><small><%= student.lessonCount || 0 %> lessons · <%= student.leaderboardScore || 0 %> points</small></div><span></span><a href="/admin/student-progress/<%= student._id %>" target="_blank" rel="noopener">Open report</a></article><% }) %></div></section>
<section class="record-panel" data-panel="deliveries" hidden><h2>Email Delivery Centre</h2><p class="section-intro">Family-email attempts attached to published and prepared paths.</p><div class="tools"><input type="search" data-filter="deliveries" placeholder="Find a student, recipient or path"><span></span></div><div class="list" data-list="deliveries"><% deliveries.forEach(function(item){ const state=item.emailDelivery.state||'pending'; %><article class="row delivery-row" data-search="<%= (item.studentName+' '+item.recipients+' '+item.pathLabel+' '+(item.emailSubject||'')).toLowerCase() %>"><div><strong><%= item.studentName %> · <%= item.pathLabel %></strong><small><%= item.emailSubject || 'A practice path' %></small></div><div><strong><%= item.recipients %></strong><small><%= item.emailDelivery.sentAt ? 'Sent '+new Date(item.emailDelivery.sentAt).toLocaleString('en-AU') : (item.emailDelivery.attemptedAt ? 'Attempted '+new Date(item.emailDelivery.attemptedAt).toLocaleString('en-AU') : 'Not attempted yet') %></small></div><span class="status status-<%= state %>"><%= state.replace('-', ' ') %></span></article><% }) %><% if(!deliveries.length){ %><div class="empty">Email delivery records will gather here when family emails are requested.</div><% } %></div></section>
<section class="record-panel" data-panel="scheduled" hidden><h2>Scheduled Path Queue</h2><p class="section-intro">Reschedule here, or open a path in the archive to review and publish it.</p><div class="list"><% scheduled.forEach(function(item){ const due=new Date(item.scheduledFor)<=new Date(); %><article class="row queue-row"><div><strong><%= item.studentName %> · <%= item.pathLabel %></strong><small><%= due ? 'Ready for review now' : 'Waiting for its planned date' %> · <%= new Date(item.scheduledFor).toLocaleString('en-AU') %></small></div><form class="queue-form" action="/admin/scheduled-path-reschedule" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="week_id" value="<%= item._id %>"><label>New date and time<input type="datetime-local" name="scheduledFor" required></label><button class="record-action" type="submit">Reschedule</button></form><form action="/choose-week" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="week_id" value="<%= item._id %>"><button class="record-action" type="submit">Review in archive</button></form></article><% }) %><% if(!scheduled.length){ %><div class="empty">There are no paths waiting in the scheduled queue.</div><% } %></div></section>
<section class="record-panel" data-panel="materials" hidden><h2>Materials catalogue</h2><div class="tools"><input type="search" data-filter="materials" placeholder="Search filename, student or piece"><select data-material-type><option value="">All formats</option><option value="application/pdf">PDF</option><option value="image/">Images</option><option value="audio/">Audio</option></select></div><div class="list" data-list="materials"><% materials.forEach(function(item){ %><article class="row" data-type="<%= item.mimeType %>" data-search="<%= (item.name+' '+item.studentName+' '+item.pieceName).toLowerCase() %>"><div><strong><%= item.name %></strong><small><%= item.studentName %> · <%= item.pieceName %></small></div><small><%= item.mimeType %></small><a href="/path-materials/<%= item.weekId %>/<%= item.materialId %>" target="_blank" rel="noopener">Open</a></article><% }) %><% if(!materials.length){ %><div class="empty">Uploaded path materials will gather here.</div><% } %></div></section>
<section class="record-panel" data-panel="activity" hidden><h2>Recent studio activity</h2><div class="list"><% activity.forEach(function(item){ %><article class="row activity"><small><%= new Date(item.createdAt).toLocaleString('en-AU') %></small><strong><%= item.action %></strong><span><%= item.detail %></span></article><% }) %><% if(!activity.length){ %><div class="empty">New administrative actions will be recorded from this release onward.</div><% } %></div></section>
<section class="record-panel" data-panel="health" hidden><h2>Studio Health Check</h2><p class="section-intro">A live, plain-language view of the services the studio relies upon.</p><div class="health-grid"><% health.forEach(function(item){ %><article class="health-card <%= item.state %>"><span class="status status-<%= item.state %>"><%= item.state %></span><h3><%= item.name %></h3><p><%= item.detail %></p></article><% }) %></div></section>
<section class="record-panel" data-panel="backup" hidden><h2>Backup centre</h2><% backupStatus.forEach(function(message){ %><div class="record-notice success" role="status"><%= message %></div><% }) %><div class="backup-note"><strong>Keep the passphrase somewhere separate and secure.</strong> It is never stored by the studio and cannot be recovered. Uploaded PDF, image and audio files are listed in the backup, but the files themselves are not included.</div><div class="backup-grid"><form class="backup-card" action="/admin/backup-download" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h3>Create encrypted backup</h3><p>Downloads student records, paths, templates, activity and the points catalogue in an encrypted Studio Backup file.</p><label for="backupPassphrase">New backup passphrase</label><input id="backupPassphrase" name="passphrase" type="password" minlength="12" maxlength="200" autocomplete="new-password" required><button type="submit">Download encrypted backup</button></form><form class="backup-card" action="/admin/backup-inspect" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h3>Validate a backup</h3><p>Checks that the file opens and reports what is inside. No studio data will be changed.</p><label for="backupFile">Studio Backup file</label><input id="backupFile" name="backupFile" type="file" required><p>Select the downloaded <strong>.studio-backup</strong> file. Other files will be safely rejected.</p><label for="inspectPassphrase">Backup passphrase</label><input id="inspectPassphrase" name="passphrase" type="password" minlength="12" maxlength="200" autocomplete="current-password" required><button type="submit">Validate without restoring</button></form></div></section></main><script>document.querySelectorAll('[data-tab]').forEach(function(button){button.addEventListener('click',function(){document.querySelectorAll('[data-tab]').forEach(function(item){item.classList.toggle('active',item===button)});document.querySelectorAll('[data-panel]').forEach(function(panel){panel.hidden=panel.dataset.panel!==button.dataset.tab})})});document.querySelectorAll('[data-filter]').forEach(function(input){input.addEventListener('input',filter)});var type=document.querySelector('[data-material-type]');type.addEventListener('change',filter);function filter(){document.querySelectorAll('[data-list]').forEach(function(list){var query=(document.querySelector('[data-filter="'+list.dataset.list+'"]')||{value:''}).value.trim().toLowerCase();list.querySelectorAll('[data-search]').forEach(function(row){var typeMatch=list.dataset.list!=='materials'||!type.value||row.dataset.type.indexOf(type.value)===0;row.hidden=!!query&&!row.dataset.search.includes(query)||!typeMatch})})}var requestedTab=location.hash.slice(1);var requestedButton=document.querySelector('[data-tab="'+requestedTab+'"]');if(requestedButton)requestedButton.click()</script><script src="/pwa.js" defer></script></body></html>
