<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Rye&display=swap" rel="stylesheet">
  <title>Path Archive | Music Learning Studio</title>
  <style>
    :root{--ink:#19303a;--muted:#63747a;--paper:#f7f4ec;--white:#fff;--line:#d8ddd8;--teal:#087f76;--yellow:#f2c94c;--coral:#d96c50;--navy:#15364c}
    *{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:"DM Sans",sans-serif;letter-spacing:0}button,input,select,textarea{font:inherit}.top{background:var(--navy);color:white}.top-inner{max-width:1180px;margin:auto;min-height:72px;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font-family:Rye,serif;color:white;text-decoration:none;font-size:18px}.nav{display:flex;gap:6px;align-items:center}.nav a,.logout{border:1px solid transparent;border-radius:4px;color:#dce9ed;text-decoration:none;background:none;padding:8px 10px;cursor:pointer;white-space:nowrap}.nav a:hover,.nav a.is-active{background:var(--yellow);border-color:var(--yellow);color:var(--navy)}
    main{max-width:1180px;margin:auto;padding:48px 24px 80px}.eyebrow{font-size:12px;text-transform:uppercase;font-weight:700;color:var(--teal);letter-spacing:1.5px}.title{font-family:Rye,serif;font-weight:400;font-size:clamp(36px,5vw,60px);margin:8px 0 12px}.intro{font-size:18px;line-height:1.55;color:var(--muted);max-width:710px;margin:0 0 34px}.notice{padding:13px 16px;margin:0 0 12px;border-left:5px solid var(--teal);background:#e9f5f2}.notice.error{border-color:var(--coral);background:#fff0ec}
    .archive-tools{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:24px 0;display:grid;grid-template-columns:minmax(230px,1fr) minmax(230px,1fr) auto;gap:14px;align-items:end}.field{display:flex;flex-direction:column;gap:7px}.field label{font-size:13px;font-weight:700}.field small{color:var(--muted)}input,select,textarea{width:100%;border:1px solid #b9c3c1;background:white;color:var(--ink);padding:11px 12px;border-radius:4px;outline:none}input:focus,select:focus,textarea:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(8,127,118,.12)}textarea{min-height:84px;resize:vertical}.new-path{display:inline-flex;align-items:center;justify-content:center;background:var(--teal);color:white;text-decoration:none;padding:12px 17px;font-weight:700;border-radius:4px;white-space:nowrap}
    .archive-status{display:flex;justify-content:space-between;gap:20px;align-items:center;margin:28px 0 14px}.archive-status h2{font-size:23px;margin:0}.archive-count{color:var(--muted)}.empty{border-left:5px solid var(--yellow);background:white;padding:28px;line-height:1.55}.path-list{display:grid;gap:12px}.path-card{background:white;border:1px solid var(--line)}.path-summary{width:100%;border:0;background:white;text-align:left;padding:20px;display:grid;grid-template-columns:110px minmax(0,1fr) minmax(180px,.7fr) auto;gap:18px;align-items:center;cursor:pointer;color:var(--ink)}.path-summary:hover{background:#f1f7f5}.path-date{font-size:13px;color:var(--muted)}.path-piece{font-weight:700;font-size:18px}.path-focus{color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.path-mark{color:var(--teal);font-weight:800}.legacy-mark{font-size:11px;text-transform:uppercase;color:#92533d;background:#ffede6;padding:4px 7px}.edit-region{display:none;border-top:1px solid var(--line);padding:26px;background:#fbfaf6}.path-card.open .edit-region{display:block}.path-card.open .path-mark{transform:rotate(45deg)}
    .editor-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);gap:28px}.edit-fields{display:grid;gap:16px}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.tasks{display:grid;gap:10px}.task{border-left:4px solid var(--coral);padding:12px;background:white;display:grid;grid-template-columns:1fr 1fr;gap:9px}.task .wide{grid-column:1/-1}.task-head{grid-column:1/-1;display:flex;justify-content:space-between;font-size:12px;font-weight:700;color:var(--muted)}.remove{border:0;background:none;color:#9b3f2c;cursor:pointer}.add-task{justify-self:start;border:1px solid var(--teal);background:transparent;color:var(--teal);font-weight:700;padding:9px 12px;cursor:pointer}.legacy-note{background:#fff5df;border-left:4px solid var(--yellow);padding:12px;color:#685a36;font-size:13px;line-height:1.5}
    details{border-top:1px solid var(--line);padding:14px 0}summary{cursor:pointer;font-weight:700}.ratings{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding-top:13px}.ratings label{font-size:12px;font-weight:700}.preview{background:var(--navy);color:white;padding:24px;align-self:start;position:sticky;top:18px}.preview small{color:#9fddd4;text-transform:uppercase;font-weight:700}.preview h3{font-family:Rye,serif;font-weight:400;font-size:25px;margin:8px 0 14px}.preview p,.preview li{line-height:1.5}.preview ol{padding-left:20px}.preview-knot{color:#f7dd82;border-top:1px solid rgba(255,255,255,.2);padding-top:14px}.save-row{display:flex;justify-content:flex-end;gap:12px;border-top:1px solid var(--line);padding-top:17px}.cancel{border:1px solid #9aacab;background:white;padding:11px 15px;cursor:pointer}.save{border:0;background:var(--teal);color:white;padding:11px 17px;font-weight:800;cursor:pointer}
    .piece-edit-list{display:grid;gap:18px}.piece-editor{border:1px solid var(--line);border-top:5px solid var(--teal);display:grid;gap:14px;padding:18px}.piece-editor-head{align-items:center;display:flex;gap:12px;justify-content:space-between}.piece-editor-head>div{display:flex;flex-wrap:wrap;gap:6px}.piece-editor-head button{border:1px solid #9aacab;background:#fff;color:var(--ink);cursor:pointer;font-size:11px;padding:6px 8px}.piece-editor-head button:disabled,.remove-task:disabled,.add-piece:disabled{cursor:not-allowed;opacity:.4}.remove-task{border:0;background:none;color:#9b3f2c;cursor:pointer}.add-piece{justify-self:start;border:1px solid var(--navy);background:var(--navy);color:#fff;font-weight:700;padding:10px 13px;cursor:pointer}.preview-piece{border-top:1px solid rgba(255,255,255,.22);padding-top:14px;margin-top:14px}.preview-piece:first-child{border-top:0;margin-top:0;padding-top:0}.preview-general{border-top:1px solid rgba(255,255,255,.22);color:#9fddd4;padding-top:14px}.preview-content h3{font-size:22px}.state-badge{font-size:11px;font-weight:800;text-transform:uppercase;padding:4px 7px;background:#dfe9e6;color:var(--teal)}.state-badge.draft{background:#fff0c2;color:#725800}.publish-draft{border:0;background:var(--coral);color:#fff;padding:11px 17px;font-weight:800;cursor:pointer}.email-state{background:#eef4f3;border-left:4px solid var(--teal);font-size:13px;padding:11px 12px}.resend-email{border:1px solid var(--navy);background:#fff;color:var(--navy);padding:10px 13px;font-weight:700;cursor:pointer}
    @media(max-width:850px){.archive-tools{grid-template-columns:1fr 1fr}.new-path{grid-column:1/-1}.path-summary{grid-template-columns:90px minmax(0,1fr) auto}.path-focus{grid-column:2/3}.editor-grid{grid-template-columns:1fr}.preview{position:static}}
    @media(max-width:850px){.top-inner{align-items:flex-start;flex-direction:column}.nav{max-width:100%;overflow-x:auto;width:100%}}
    @media(max-width:560px){main{padding:34px 16px 60px}.top-inner{padding:12px 16px}.nav a,.logout{font-size:13px;padding:7px 8px}.archive-tools,.two,.ratings,.task{grid-template-columns:1fr}.path-summary{grid-template-columns:1fr auto;gap:7px}.path-date,.path-focus{grid-column:1}.path-mark{grid-column:2;grid-row:1/4}.task .wide,.task-head{grid-column:1}.edit-region{padding:18px 14px}.archive-status{align-items:flex-start}}
  </style>
</head>
<body>
  <header class="top"><div class="top-inner"><a class="brand" href="/admin">Music Learning Studio</a><nav class="nav" aria-label="Studio administration"><a href="/admin">Studio Desk</a><a href="/create-week">Prepare Path</a><a class="is-active" href="/choose-week" aria-current="page">Path Archive</a><form action="/logout" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="logout" type="submit">Log out</button></form></nav></div></header>
  <main>
    <div class="eyebrow">Studio records</div><h1 class="title">Path Archive</h1><p class="intro">Find a student's past path by its musical meaning, not by a database number. Open any record to revise it in context.</p>
    <% success.forEach(function(message){ %><div class="notice"><%= message %></div><% }) %><% errors.forEach(function(message){ %><div class="notice error"><%= message %></div><% }) %>
    <section class="archive-tools"><div class="field"><label for="student">Student</label><select id="student"><option value="">Choose a student</option><% studentList.forEach(function(student){ %><option value="<%= student._id %>"><%= student.fName %> <%= student.lName %></option><% }) %></select></div><div class="field"><label for="search">Search their paths</label><input id="search" type="search" placeholder="Piece, focus, observation or note" disabled></div><a class="new-path" href="/create-week">+ Prepare a new path</a></section>
    <div class="archive-status"><h2 id="archiveHeading">Recent paths</h2><span class="archive-count" id="archiveCount"></span></div><div id="archive"><div class="empty">Choose a student to open their archive.</div></div>
  </main>
  <span id="archiveConfig" data-csrf="<%= csrfToken %>" hidden></span>
  <script src="/pathArchive.js?v=2" defer></script>
</body></html>
