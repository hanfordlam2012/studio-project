<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= week.pieceName || 'Lesson notes' %><%= Array.isArray(week.pieces)&&week.pieces.length>1 ? ' + '+(week.pieces.length-1)+' more' : '' %> | Printable lesson</title>
  <style>
    :root{--ink:#19303a;--muted:#63747a;--line:#ccd6d8;--navy:#15364c;--teal:#087f76;--yellow:#f2c94c}*{box-sizing:border-box}body{background:#eef2ef;color:var(--ink);font-family:Arial,sans-serif;line-height:1.55;margin:0}.toolbar{align-items:center;background:var(--navy);color:#fff;display:flex;justify-content:space-between;padding:14px max(18px,calc((100vw - 820px)/2))}.toolbar span{font-size:14px}.toolbar button{background:var(--yellow);border:0;color:#272200;cursor:pointer;font:700 15px Arial;padding:10px 16px}.sheet{background:#fff;margin:28px auto;max-width:820px;min-height:1050px;padding:56px 62px}.kicker{color:var(--teal);font-size:12px;font-weight:700;text-transform:uppercase}.sheet h1{color:var(--navy);font-family:Georgia,serif;font-size:34px;margin:7px 0}.meta{border-bottom:2px solid var(--navy);color:var(--muted);margin-bottom:28px;padding-bottom:14px}.notes h1,.notes h2,.notes h3{color:var(--navy);font-family:Georgia,serif}.notes blockquote{background:#fff8dc;border-left:5px solid #d96c50;margin:18px 0;padding:12px 16px}.snapshot{border-top:1px solid var(--line);margin-top:34px;padding-top:22px}.ratings{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.rating{background:#eef3f5;border-top:4px solid var(--teal);padding:10px}.rating span,.rating strong{display:block}.rating span{color:var(--muted);font-size:11px}.technical{background:#fff8dc;border-left:5px solid #d96c50;margin-top:18px;padding:12px 16px}.technical strong,.technical span{display:block}@media(max-width:700px){.sheet{margin:0;min-height:0;padding:34px 22px}.ratings{grid-template-columns:1fr 1fr}.toolbar{position:sticky;top:0}}@media print{@page{margin:15mm}.toolbar{display:none}.sheet{margin:0;max-width:none;min-height:0;padding:0}.ratings{break-inside:avoid}body{background:#fff}}
  </style>
</head>
<body>
  <header class="toolbar"><span>Printable lesson notes</span><button type="button" onclick="window.print()">Print</button></header>
  <main class="sheet"><div class="kicker">Music Learning Studio · <%= studentName %></div><h1><%= week.pieceName || 'Lesson notes' %></h1><div class="meta"><%= new Date(week.createdDate).toLocaleDateString('en-AU',{day:'numeric',month:'long',year:'numeric'}) %><% if(week.lessonFocus){ %> · <%= week.lessonFocus %><% } %></div><section class="notes"><%- filterUserHTML(week.comments || 'No notes were recorded for this lesson.') %></section><section class="snapshot"><div class="kicker">Development snapshot</div><div class="ratings"><% [['rhythm','Pulse'],['coordination','Pitch'],['tone','Articulation'],['dynamics','Dynamics'],['stylistic','Body feeling']].forEach(function(item){ %><div class="rating"><span><%= item[1] %></span><strong><%= week[item[0]] || '—' %> / 5</strong></div><% }) %></div><% if(week.techAName||week.techBName){ %><div class="technical"><div class="kicker">Technical work</div><% if(week.techAName){ %><strong><%= week.techAName %></strong><span><%= week.techAScore || 'Not scored' %> / 5</span><% } %><% if(week.techBName){ %><strong><%= week.techBName %></strong><span><%= week.techBScore || 'Not scored' %> / 5</span><% } %></div><% } %></section></main>
</body></html>
