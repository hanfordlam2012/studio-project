      <script>
        function generateRainbowText(element) {
          let text = element.innerText;
          element.innerHTML = "";
          for (let i = 0; i < text.length; i++) {
            let charElem = document.createElement("span");
            charElem.style.color = "hsl(" + (360 * i / text.length) + ",100%,50%)";
            charElem.style.fontWeight = "bold";
            charElem.style.textShadow = "0px 4px 5px hsl(" + (360 * i / text.length) + ",80%,20%), 4px 0px 5px hsl(" + (360 * i / text.length) + ",80%,20%), -4px 0px 5px hsl(" + (360 * i / text.length) + ",80%,20%), 0px -4px 5px hsl(" + (360 * i / text.length) + ",80%,20%)";
            charElem.innerHTML = text[i];
            element.appendChild(charElem);
          }
        }

        window.addEventListener("load", function() {
          let elements = document.getElementsByClassName("rainbowText");
          for (let i = 0; i < elements.length; i++) {
            generateRainbowText(elements[i]);
          }
        });
      </script>
      <script>
        (function () {
          const widget = document.querySelector("[data-wiki-music-widget]");
          if (!widget) return;

          const items = [
            "Aeolian harp",
            "Alphorn",
            "Appalachian dulcimer",
            "Arpeggione",
            "Baryton",
            "Bazantar",
            "Celesta",
            "Cristal Baschet",
            "Crwth",
            "Didgeridoo",
            "Erhu",
            "Glass harmonica",
            "Hardanger fiddle",
            "Hurdy-gurdy",
            "Hydraulophone",
            "Jew's harp",
            "Kora (instrument)",
            "Mbira",
            "Musical saw",
            "Nyckelharpa",
            "Ocarina",
            "Ondes Martenot",
            "Otamatone",
            "Pyrophone",
            "Rackett",
            "Serpent (instrument)",
            "Singing bowl",
            "Stylophone",
            "Theremin",
            "Toy piano",
            "Trautonium",
            "Waterphone",
            "Zither",
            "Prepared piano",
            "Player piano",
            "Tape loop",
            "Mellotron",
            "Optigan",
            "Orchestrion",
            "Telharmonium",
            "Clavichord",
            "Virginal",
            "Theorbo",
            "Contrabassoon",
            "Subcontrabass flute",
            "Piccolo trumpet",
            "Harmonic series (music)",
            "Wolf interval",
            "Comma (music)",
            "Just intonation",
            "Microtonal music",
            "Scordatura",
            "Col legno",
            "Sul ponticello",
            "Bowed piano",
            "Inside piano",
            "Extended technique",
            "Overtone singing",
            "Yodeling",
            "Throat singing",
            "Beatboxing",
            "Hocket",
            "Isorhythm",
            "Phasing (music)",
            "Euclidean rhythm",
            "Hemiola",
            "Polyrhythm",
            "Clave (rhythm)",
            "Shepard tone",
            "Tritone",
            "Blue note",
            "Ostinato",
            "Ground bass",
            "Passacaglia",
            "Chaconne",
            "Soggetto cavato",
            "BACH motif",
            "Musical cryptogram",
            "Klangfarbenmelodie",
            "Augenmusik",
            "Tintinnabuli",
            "Micropolyphony",
            "Musique concrete",
            "Tape music",
            "Acousmatic music",
            "Aleatoric music",
            "Graphic notation",
            "Shape note",
            "Solresol",
            "Guidonian hand",
            "Dies irae",
            "L'homme arme",
            "Nonsense song",
            "Sea shanty",
            "Murder ballad",
            "Black MIDI",
            "The Well-Tuned Piano",
            "As Slow as Possible",
            "I Am Sitting in a Room",
            "Poeme symphonique",
            "The Unanswered Question",
            "Conlon Nancarrow",
            "Harry Partch",
            "Moondog",
            "Raymond Scott",
            "Delia Derbyshire",
            "Wendy Carlos",
            "Meredith Monk",
            "Florence Foster Jenkins",
            "Outsider music",
            "Sound sculpture"
          ];
          const titleEl = widget.querySelector("[data-wiki-title]");
          const extractEl = widget.querySelector("[data-wiki-extract]");
          const linkEl = widget.querySelector("[data-wiki-link]");
          const button = widget.querySelector("[data-wiki-next]");
          const storageKey = "hanfordMusicRabbitHole";
          const recentKey = "hanfordMusicRabbitHoleRecent";
          const recentLimit = 16;
          let currentIndex = pickRandomIndex();

          function readRecent() {
            try {
              const saved = JSON.parse(localStorage.getItem(recentKey));
              return Array.isArray(saved) ? saved : [];
            } catch (error) {
              return [];
            }
          }

          function saveRecent(title) {
            try {
              const recent = readRecent().filter(function (item) {
                return item !== title;
              });
              recent.unshift(title);
              localStorage.setItem(recentKey, JSON.stringify(recent.slice(0, recentLimit)));
            } catch (error) {
            }
          }

          function pickRandomIndex() {
            const recent = readRecent();
            const available = items
              .map(function (title, index) {
                return { title: title, index: index };
              })
              .filter(function (item) {
                return recent.indexOf(item.title) === -1;
              });
            const pool = available.length ? available : items.map(function (title, index) {
              return { title: title, index: index };
            });
            return pool[Math.floor(Math.random() * pool.length)].index;
          }

          function wikiUrl(title) {
            return "https://en.wikipedia.org/wiki/" + encodeURIComponent(title.replace(/ /g, "_"));
          }

          function shortExtract(text) {
            if (!text) return "Open this Wikipedia entry for a compact musical detour.";
            if (text.length <= 280) return text;
            return text.slice(0, 277).replace(/\s+\S*$/, "") + "...";
          }

          function showLoading() {
            titleEl.textContent = "Finding a musical item...";
            extractEl.textContent = "Asking Wikipedia for something worth exploring.";
            linkEl.href = "https://en.wikipedia.org/wiki/Music";
          }

          function showItem(item) {
            titleEl.textContent = item.title;
            extractEl.textContent = item.extract;
            linkEl.href = item.url;
          }

          function saveItem(item) {
            try {
              localStorage.setItem(storageKey, JSON.stringify(item));
            } catch (error) {
            }
          }

          function restoreItem() {
            try {
              const saved = JSON.parse(localStorage.getItem(storageKey));
              if (saved && saved.title && saved.extract && saved.url) {
                showItem(saved);
                return true;
              }
            } catch (error) {
            }
            return false;
          }

          function showFallback() {
            const fallbackTitle = items[currentIndex];
            showItem({
              title: fallbackTitle,
              extract: "Wikipedia is taking a moment, but this topic is still a useful musical doorway.",
              url: wikiUrl(fallbackTitle)
            });
          }

          function loadItem() {
            const title = items[currentIndex];
            showLoading();
            fetch("https://en.wikipedia.org/api/rest_v1/page/summary/" + encodeURIComponent(title))
              .then(function (response) {
                if (!response.ok) throw new Error("Wikipedia request failed");
                return response.json();
              })
              .then(function (data) {
                const item = {
                  title: data.title || title,
                  extract: shortExtract(data.extract),
                  url: data.content_urls && data.content_urls.desktop ? data.content_urls.desktop.page : wikiUrl(title)
                };
                showItem(item);
                saveItem(item);
                saveRecent(title);
              })
              .catch(function () {
                if (!restoreItem()) {
                  showFallback();
                }
              });
          }

          button.addEventListener("click", function () {
            currentIndex = pickRandomIndex();
            loadItem();
          });

          loadItem();
        }());
      </script>

