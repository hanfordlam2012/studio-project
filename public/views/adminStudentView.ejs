<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#15364c"><link rel="manifest" href="/manifest.webmanifest"><link rel="shortcut icon" href="/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Rye&display=swap" rel="stylesheet">
  <title><%= student.fName %>'s Student View | Music Learning Studio</title>
  <style>
    :root{--ink:#19303a;--muted:#63747a;--paper:#f7f4ec;--white:#fff;--line:#d8ddd8;--teal:#087f76;--yellow:#f2c94c;--coral:#d96c50;--navy:#15364c}
    *{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:"DM Sans",sans-serif;letter-spacing:0}.top{background:var(--navy);color:#fff}.top-inner{max-width:1120px;min-height:72px;margin:auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font-family:Rye,serif;color:#fff;text-decoration:none;font-size:18px}.nav{display:flex;align-items:center;gap:6px;overflow-x:auto}.nav a{border:1px solid transparent;border-radius:4px;color:#dce9ed;text-decoration:none;padding:8px 10px;white-space:nowrap}.nav a:hover,.nav a.is-active{background:var(--yellow);border-color:var(--yellow);color:var(--navy)}
    main{max-width:1120px;margin:auto;padding:42px 24px 80px}.view-bar{align-items:center;background:#e9f5f2;border-left:5px solid var(--teal);display:flex;gap:18px;justify-content:space-between;margin-bottom:28px;padding:14px 16px}.view-bar strong{display:block}.view-bar span{color:var(--muted);font-size:13px}.back{background:var(--navy);border-radius:4px;color:#fff;font-weight:700;padding:10px 13px;text-decoration:none;white-space:nowrap}.eyebrow{color:var(--teal);font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase}.title{font-family:Rye,serif;font-size:clamp(36px,6vw,62px);font-weight:400;line-height:1.08;margin:7px 0 24px}.switcher{margin-bottom:30px}.switcher select{background:#fff;border:1px solid #aebbb8;border-radius:4px;font:inherit;min-height:44px;padding:10px 12px;width:100%}
    .stats{background:#fff;border:1px solid var(--line);display:grid;grid-template-columns:repeat(3,1fr);margin-bottom:22px}.stat{padding:19px}.stat+ .stat{border-left:1px solid var(--line)}.stat span{color:var(--muted);display:block;font-size:11px;font-weight:700;text-transform:uppercase}.stat strong{display:block;font-size:28px;margin-top:4px}.layout{display:grid;gap:20px;grid-template-columns:minmax(0,1.55fr) minmax(250px,.75fr)}.panel{background:#fff;border:1px solid var(--line);padding:22px}.panel h2{font-size:22px;margin:0 0 14px}.path{line-height:1.65}.path h1,.path h2,.path h3{font-size:18px;margin:20px 0 8px}.path p:first-child{margin-top:0}.empty{border-left:4px solid var(--yellow);color:var(--muted);padding:12px 14px}.achievements{display:flex;flex-wrap:wrap;gap:8px}.achievement{background:#e9f5f2;border:1px solid #b8dcd7;border-radius:4px;padding:7px 9px}.history{display:grid;gap:10px}.history article{border-top:1px solid var(--line);padding-top:12px}.history time{color:var(--muted);font-size:12px}.history strong{display:block;margin-top:3px}
    @media(max-width:760px){.top-inner{align-items:flex-start;flex-direction:column}.nav{width:100%}.layout{grid-template-columns:1fr}.switcher{grid-template-columns:1fr 1fr}.switcher select{grid-column:1/-1;grid-row:1}.stats{grid-template-columns:1fr}.stat+ .stat{border-left:0;border-top:1px solid var(--line)}}@media(max-width:520px){main{padding:32px 16px 60px}.top-inner{padding:12px 16px}.view-bar{align-items:flex-start;flex-direction:column}.back{width:100%;text-align:center}}
  </style>
</head>
<body>
  <header class="top"><div class="top-inner"><a class="brand" href="/admin">Music Learning Studio</a><nav class="nav" aria-label="Studio administration"><a href="/admin">Studio Desk</a><a href="/create-week">Prepare Path</a><a href="/choose-week">Path Archive</a></nav></div></header>
  <main>
    <div class="view-bar"><div><strong>Read-only student view</strong><span>You remain signed in as administrator. Nothing on this page changes student data.</span></div><a class="back" href="/admin#studentList">Back to Studio Desk</a></div>
    <% adErrors.forEach(function(message){ %><div class="empty"><%= message %></div><% }) %>
    <div class="eyebrow">A window into the learning park</div><h1 class="title"><%= student.fName %>'s Learning Park</h1>
    <div class="switcher"><select id="studentPicker" aria-label="Choose a student"><% students.forEach(function(option){ %><option value="<%= option._id %>" <%= String(option._id)===String(student._id)?'selected':'' %>><%= option.fName %> <%= option.lName %></option><% }) %></select></div>
    <section class="stats" aria-label="Student summary"><div class="stat"><span>Points</span><strong><%= student.leaderboardScore || 0 %></strong></div><div class="stat"><span>Lessons used</span><strong><%= student.lessonCount || 0 %> / <%= student.paidLessons || 0 %></strong></div><div class="stat"><span>Paths shown</span><strong><%= weeks.length %></strong></div></section>
    <div class="layout"><section class="panel"><h2>Current path</h2><% if(weeks.length){ %><div class="path"><%- filterUserHTML(weeks[0].comments || '') %></div><% } else { %><div class="empty">No lesson path has been published for this student yet.</div><% } %></section><aside><section class="panel"><h2>Achievements</h2><% const achievements=[].concat(student.missionsAccomplished || [],student.repertoirePolished || []); %><% if(achievements.length){ %><div class="achievements"><% achievements.forEach(function(item){ %><span class="achievement"><%= typeof item==='string' ? item : (item.title || item.name || 'Achievement') %></span><% }) %></div><% } else { %><div class="empty">No achievements recorded yet.</div><% } %></section><section class="panel" style="margin-top:20px"><h2>Recent lesson history</h2><div class="history"><% weeks.forEach(function(week){ %><article><time><%= week.createdDate ? new Date(week.createdDate).toLocaleDateString('en-AU',{day:'numeric',month:'long',year:'numeric'}) : 'Date not recorded' %></time><strong><%= week.pieceName || week.lessonFocus || 'Lesson path' %></strong></article><% }) %><% if(!weeks.length){ %><div class="empty">History will appear after the first path is published.</div><% } %></div></section></aside></div>
  </main>
  <script>document.querySelector('#studentPicker').addEventListener('change',function(){window.location.href='/admin/student-view?studentId='+encodeURIComponent(this.value)})</script><script src="/pwa.js" defer></script>
</body></html>
