<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#15364c"><link rel="manifest" href="/manifest.webmanifest"><link rel="shortcut icon" href="/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Rye&display=swap" rel="stylesheet">
  <title>Studio Desk | Music Learning Studio</title>
  <style>
    :root{--ink:#19303a;--muted:#63747a;--paper:#f7f4ec;--white:#fff;--line:#d8ddd8;--teal:#087f76;--yellow:#f2c94c;--coral:#d96c50;--navy:#15364c}
    *{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:"DM Sans",sans-serif;letter-spacing:0}button,input{font:inherit}.top{background:var(--navy);color:#fff}.top-inner{max-width:1180px;min-height:72px;margin:auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font-family:Rye,serif;color:#fff;text-decoration:none;font-size:18px}.nav{display:flex;align-items:center;gap:6px}.nav a,.logout{border:1px solid transparent;border-radius:4px;color:#dce9ed;text-decoration:none;background:none;padding:8px 10px;cursor:pointer;white-space:nowrap}.nav a:hover,.nav a.is-active{background:var(--yellow);border-color:var(--yellow);color:var(--navy)}
    main{max-width:1180px;margin:auto;padding:48px 24px 80px}.eyebrow{font-size:12px;font-weight:700;text-transform:uppercase;color:var(--teal);letter-spacing:1.5px}.title{font-family:Rye,serif;font-weight:400;font-size:clamp(38px,6vw,68px);line-height:1.05;margin:8px 0 34px}.notice{padding:13px 16px;margin:0 0 18px;border-left:5px solid var(--coral);background:#fff0ec}.notice.success{background:#e9f5f2;border-color:var(--teal)}
    .summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border:1px solid var(--line);background:#fff}.summary div{padding:20px;border-right:1px solid var(--line)}.summary div:last-child{border:0}.summary span,.student-meta span{display:block;color:var(--muted);font-size:11px;font-weight:700;text-transform:uppercase}.summary strong{display:block;font-size:29px;margin-top:5px}
    .section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;border-top:1px solid var(--line);padding-top:34px;margin-bottom:17px}.section-head h2{font-size:25px;margin:0}.section-head p{display:none}.search{max-width:260px;border:1px solid #b9c3c1;background:#fff;padding:10px 12px;border-radius:4px}.student-list{display:grid;gap:10px}.student{display:grid;grid-template-columns:minmax(220px,1.35fr) repeat(4,minmax(95px,.55fr)) auto;gap:15px;align-items:center;background:#fff;border:1px solid var(--line);padding:16px 18px}.student-name strong{display:block;font-size:17px}.student-name>span{color:var(--muted);display:block;font-size:13px;overflow-wrap:anywhere}.student-username{margin-bottom:3px}.student-meta strong{display:block;margin-top:4px}.student-view-link{background:var(--navy);border-radius:4px;color:#fff;font-size:13px;font-weight:700;padding:9px 11px;text-align:center;text-decoration:none;white-space:nowrap}.student-view-link:hover{background:var(--teal)}.inline-edit{border-bottom:1px dashed var(--teal);cursor:text;display:inline-block!important}.inline-edit:focus{background:#e9f5f2;outline:3px solid rgba(8,127,118,.18)}.inline-input{border:2px solid var(--teal);border-radius:3px;max-width:120px;padding:4px 6px;width:100%}.inline-input.is-wide{max-width:100%;min-width:180px}.save-state{color:var(--teal);font-size:12px;min-height:20px;margin:8px 0}.save-state.is-error{color:#a42b2b}.is-due{color:#a34532}.empty{background:#fff;border-left:5px solid var(--yellow);padding:22px}.rewards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.reward{background:#fff;border:1px solid var(--line);border-top:5px solid var(--reward);padding:18px}.reward-form{display:grid;gap:11px}.reward-form label{color:var(--muted);display:grid;font-size:11px;font-weight:700;gap:5px;text-transform:uppercase}.reward-form input,.reward-form textarea{background:#fff;border:1px solid #b9c3c1;border-radius:4px;color:var(--ink);padding:9px 10px;width:100%}.reward-form textarea{min-height:72px;resize:vertical}.reward-row{align-items:end;display:grid;gap:10px;grid-template-columns:minmax(100px,1fr) 58px}.reward-form input[type=color]{cursor:pointer;height:39px;padding:3px}.reward-actions{display:flex;justify-content:flex-end}.reward-save{background:var(--teal);border:0;color:#fff;cursor:pointer;font-weight:700;padding:9px 12px}.reward-new{border-top-color:var(--yellow)}
    .student-actions{display:grid;gap:7px;min-width:126px}.password-reset{position:relative}.password-reset summary{border:1px solid var(--navy);border-radius:4px;color:var(--navy);cursor:pointer;font-size:12px;font-weight:700;list-style:none;padding:7px 9px;text-align:center}.password-reset summary::-webkit-details-marker{display:none}.password-form{background:#fff;border:1px solid var(--line);box-shadow:0 8px 24px rgba(21,54,76,.16);display:grid;gap:8px;padding:12px;position:absolute;right:0;top:38px;width:250px;z-index:4}.password-form input,.student-create input{border:1px solid #b9c3c1;border-radius:4px;padding:9px 10px;width:100%}.password-form button,.student-create button{border:0;background:var(--teal);color:#fff;cursor:pointer;font-weight:700;padding:10px 12px}.student-create{background:#fff;border-top:5px solid var(--yellow);display:grid;gap:12px;grid-template-columns:repeat(3,minmax(0,1fr));padding:20px}.student-create label{color:var(--muted);display:grid;font-size:11px;font-weight:700;gap:5px;text-transform:uppercase}.student-create .create-action{align-items:end;display:flex}.student-create .create-action button{width:100%}
    @media(max-width:850px){.top-inner{align-items:flex-start;flex-direction:column}.nav{max-width:100%;overflow-x:auto;width:100%}.rewards{grid-template-columns:1fr}.student{grid-template-columns:1fr 1fr}.student-name{grid-column:1/-1}.student-create{grid-template-columns:1fr 1fr}.student-actions{grid-column:1/-1}.password-form{left:0;right:auto}}
    @media(max-width:560px){main{padding:34px 16px 60px}.top-inner{padding:12px 16px}.nav a,.logout{font-size:13px;padding:7px 8px}.summary{grid-template-columns:1fr}.summary div{border-right:0;border-bottom:1px solid var(--line)}.section-head{align-items:stretch;flex-direction:column}.search{max-width:none;width:100%}.student{grid-template-columns:1fr 1fr}.rewards,.student-create{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <header class="top"><div class="top-inner"><a class="brand" href="/admin">Music Learning Studio</a><nav class="nav" aria-label="Studio administration"><a class="is-active" href="/admin" aria-current="page">Studio Desk</a><a href="/create-week">Prepare Path</a><a href="/choose-week">Path Archive</a><form action="/logout" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="logout" type="submit">Log out</button></form></nav></div></header>
  <main>
    <div class="eyebrow">Private studio control room</div><h1 class="title">Studio Desk</h1>
    <% adErrors.forEach(function(message){ %><div class="notice"><%= message %></div><% }) %>
    <% adminSuccess.forEach(function(message){ %><div class="notice success"><%= message %></div><% }) %>
    <% const totalPaths=students.reduce(function(sum,student){return sum+student.pathCount},0); const lessonsDue=students.filter(function(student){return Number(student.lessonCount)>=Number(student.paidLessons)}).length; %>
    <section class="summary" aria-label="Studio overview"><div><span>Active students</span><strong><%= students.length %></strong></div><div><span>Paths recorded</span><strong><%= totalPaths %></strong></div><div><span>Allowances reached</span><strong><%= lessonsDue %></strong></div></section>
    <section><div class="section-head"><div><h2>Student pulse</h2><p>Lesson use, paths and points from the live database.</p></div><input class="search" id="studentSearch" type="search" placeholder="Find a student" aria-label="Find a student"></div><div class="save-state" id="saveState" aria-live="polite"></div><div class="student-list" id="studentList">
      <% students.forEach(function(student){ const due=Number(student.lessonCount)>=Number(student.paidLessons); %>
        <article class="student" data-student="<%= (student.fName+' '+student.lName+' '+student.username+' '+student.parentName+' '+student.email).toLowerCase() %>" data-student-id="<%= student._id %>">
          <div class="student-name">
            <strong><span class="inline-edit" data-edit-field="fName" data-value="<%= student.fName %>" tabindex="0" role="button" title="Edit first name"><%= student.fName %></span> <span class="inline-edit" data-edit-field="lName" data-value="<%= student.lName %>" tabindex="0" role="button" title="Edit surname"><%= student.lName %></span></strong>
            <span class="student-username">Username: <span class="inline-edit" data-edit-field="username" data-value="<%= student.username || '' %>" data-empty-label="Not set" tabindex="0" role="button" title="Edit username"><%= student.username || 'Not set' %></span></span>
            <span><span class="inline-edit" data-edit-field="parentName" data-value="<%= student.parentName || '' %>" data-empty-label="No family contact" tabindex="0" role="button" title="Edit family contact"><%= student.parentName || 'No family contact' %></span> · <span class="inline-edit" data-edit-field="email" data-value="<%= student.email || '' %>" data-empty-label="No email recorded" tabindex="0" role="button" title="Edit family emails"><%= student.email || 'No email recorded' %></span></span>
          </div>
          <div class="student-meta"><span>Lessons used</span><strong class="<%= due?'is-due':'' %>"><b class="inline-edit" data-edit-field="lessonCount" data-value="<%= student.lessonCount || 0 %>" tabindex="0" role="button" title="Edit lessons used"><%= student.lessonCount || 0 %></b> of <b class="inline-edit" data-edit-field="paidLessons" data-value="<%= student.paidLessons || 0 %>" tabindex="0" role="button" title="Edit lesson allowance"><%= student.paidLessons || 0 %></b></strong></div>
          <div class="student-meta"><span>Paths</span><strong><%= student.pathCount %></strong></div>
          <div class="student-meta"><span>Points</span><strong class="inline-edit" data-edit-field="leaderboardScore" data-value="<%= student.leaderboardScore || 0 %>" tabindex="0" role="button" title="Edit points"><%= student.leaderboardScore || 0 %></strong></div>
          <div class="student-meta"><span>Latest path</span><strong><%= student.latestPathDate ? new Date(student.latestPathDate).toLocaleDateString('en-AU',{day:'numeric',month:'short'}) : 'None yet' %></strong></div>
          <div class="student-actions"><a class="student-view-link" href="/admin/student-view?studentId=<%= student._id %>">Student View</a><details class="password-reset"><summary>Set password</summary><form class="password-form" data-password-form action="/admin/student-password" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="studentId" value="<%= student._id %>"><label>New password<input name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" required></label><label>Confirm password<input name="passwordConfirm" data-password-confirm type="password" minlength="8" maxlength="72" autocomplete="new-password" required></label><button type="submit">Update password</button></form></details></div>
        </article>
      <% }) %>
      <% if(!students.length){ %><div class="empty">No active students are attached to this studio account yet.</div><% } %>
    </div><div class="empty" id="noStudents" hidden>No students match that search.</div></section>
    <section id="addStudent"><div class="section-head"><div><h2>Add a student</h2><p>Create a private portal account attached to this studio.</p></div></div><form class="student-create" data-password-form action="/admin/student-create" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>First name<input name="fName" maxlength="30" required></label><label>Surname<input name="lName" maxlength="30" required></label><label>Family contact<input name="parentName" maxlength="60"></label><label>Family emails<input name="email" type="text" inputmode="email" maxlength="500" placeholder="one@example.com; two@example.com"></label><label>Username<input name="username" minlength="3" maxlength="30" pattern="[A-Za-z0-9]+" autocomplete="off" required></label><label>Temporary password<input name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" required></label><label>Confirm password<input name="passwordConfirm" data-password-confirm type="password" minlength="8" maxlength="72" autocomplete="new-password" required></label><div class="create-action"><button type="submit">Add student account</button></div></form></section>
    <section id="rewards"><div class="section-head"><div><h2>Points Possibilities catalogue</h2><p>The experiences and rewards students can choose to work towards.</p></div></div><div class="rewards"><% prizes.forEach(function(prize){ %><article class="reward" style="--reward:<%= prize.color || '#087f76' %>"><form class="reward-form" action="/admin/prize" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="prizeId" value="<%= prize._id %>"><label>Possibility title<input name="title" maxlength="80" value="<%= prize.title %>" required></label><label>Description<textarea name="desc" maxlength="180"><%= prize.desc %></textarea></label><div class="reward-row"><label>Point cost<input type="number" name="price" min="1" max="999999" step="1" value="<%= prize.price %>" required></label><label>Colour<input type="color" name="color" value="<%= /^#[0-9a-f]{6}$/i.test(prize.color||'') ? prize.color : '#087f76' %>"></label></div><div class="reward-actions"><button class="reward-save" type="submit">Save possibility</button></div></form></article><% }) %><article class="reward reward-new" style="--reward:#f2c94c"><form class="reward-form" action="/admin/prize" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>New possibility title<input name="title" maxlength="80" required></label><label>Description<textarea name="desc" maxlength="180"></textarea></label><div class="reward-row"><label>Point cost<input type="number" name="price" min="1" max="999999" step="1" required></label><label>Colour<input type="color" name="color" value="#087f76"></label></div><div class="reward-actions"><button class="reward-save" type="submit">Add possibility</button></div></form></article></div></section>
  </main>
  <script>
  (function(){var csrf='<%= csrfToken %>',state=document.querySelector('#saveState');document.querySelector('#studentSearch').addEventListener('input',function(event){var query=event.target.value.trim().toLowerCase(),visible=0;document.querySelectorAll('[data-student]').forEach(function(row){var show=!query||row.dataset.student.indexOf(query)>-1;row.hidden=!show;if(show)visible++});document.querySelector('#noStudents').hidden=visible!==0});function beginEdit(display){if(display.querySelector('input'))return;var original=display.dataset.value,input=document.createElement('input'),field=display.dataset.editField,numeric=['lessonCount','paidLessons','leaderboardScore'].indexOf(field)>-1;input.type=field==='email'?'email':numeric?'number':'text';if(numeric){input.min='0';input.max=field==='leaderboardScore'?'999999':'999';input.step='1'}else{input.maxLength=field==='parentName'?60:field==='email'?120:30;input.classList.add('is-wide')}input.value=original;input.className='inline-input'+(numeric?'':' is-wide');display.textContent='';display.appendChild(input);input.focus();input.select();var finished=false;function show(value){display.textContent=value||display.dataset.emptyLabel||''}function restore(){if(finished)return;finished=true;show(original)}async function save(){if(finished)return;var value=input.value;if(value===original){restore();return}finished=true;state.className='save-state';state.textContent='Saving...';try{var response=await fetch('/admin/student-field',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({_csrf:csrf,studentId:display.closest('[data-student-id]').dataset.studentId,field:display.dataset.editField,value:value})}),data=await response.json();if(!response.ok)throw new Error(data.error||'The change could not be saved.');display.dataset.value=String(data.value);show(String(data.value));state.textContent='Saved.';window.setTimeout(function(){if(state.textContent==='Saved.')state.textContent=''},1800)}catch(error){show(original);state.className='save-state is-error';state.textContent=error.message}}input.addEventListener('keydown',function(event){if(event.key==='Enter'){event.preventDefault();save()}if(event.key==='Escape'){event.preventDefault();restore()}});input.addEventListener('blur',save)}document.querySelectorAll('[data-edit-field]').forEach(function(display){display.addEventListener('dblclick',function(){beginEdit(display)});display.addEventListener('keydown',function(event){if(event.key==='Enter'){event.preventDefault();beginEdit(display)}})})}());
  </script>
  <script>
    function prepareMultiEmailEditor(event){
      var display=event.target.closest('[data-edit-field="email"]');
      if(!display)return;
      var input=display.querySelector('input');
      if(input){input.type='text';input.inputMode='email';input.maxLength=500;input.placeholder='one@example.com; two@example.com'}
    }
    document.addEventListener('dblclick',prepareMultiEmailEditor);
    document.addEventListener('keydown',function(event){if(event.key==='Enter')window.setTimeout(function(){prepareMultiEmailEditor(event)},0)});
  </script>
  <script>
    document.querySelectorAll('[data-password-form]').forEach(function(form){
      var confirmation=form.querySelector('[data-password-confirm]');
      form.addEventListener('submit',function(event){
        if(form.password.value!==confirmation.value){
          event.preventDefault();
          confirmation.setCustomValidity('Passwords do not match.');
          confirmation.reportValidity();
        }else{
          confirmation.setCustomValidity('');
        }
      });
      confirmation.addEventListener('input',function(){confirmation.setCustomValidity('')});
    });
  </script><script src="/pwa.js" defer></script>
</body></html>
