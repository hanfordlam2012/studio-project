<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="shortcut icon" href="favicon.png" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Rye&display=swap" rel="stylesheet">
  <title>Prepare the Next Path | Music Learning Studio</title>
  <style>
    :root{--ink:#19303a;--muted:#63747a;--paper:#f7f4ec;--white:#fff;--line:#d8ddd8;--teal:#087f76;--yellow:#f2c94c;--coral:#d96c50;--navy:#15364c}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:"DM Sans",sans-serif;letter-spacing:0}
    button,input,select,textarea{font:inherit}.path-top{background:var(--navy);color:white}.path-top-inner{max-width:1180px;margin:auto;min-height:72px;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:20px}.path-brand{color:white;text-decoration:none;font-family:Rye,serif;font-size:18px}.path-nav{display:flex;gap:6px;align-items:center}.path-nav a,.path-logout{border:1px solid transparent;border-radius:4px;color:#dce9ed;background:none;text-decoration:none;cursor:pointer;padding:8px 10px;white-space:nowrap}.path-nav a:hover,.path-nav a.is-active{background:var(--yellow);border-color:var(--yellow);color:var(--navy)}
    main{max-width:1180px;margin:auto;padding:48px 24px 80px}.path-eyebrow{font-size:12px;font-weight:700;text-transform:uppercase;color:var(--teal);letter-spacing:1.5px}.path-title{font-family:Rye,serif;font-weight:400;font-size:clamp(34px,5vw,62px);line-height:1.08;margin:8px 0 14px}.path-intro{max-width:700px;color:var(--muted);font-size:18px;line-height:1.6;margin:0 0 38px}
    .notice{padding:13px 16px;margin:0 0 12px;border-left:5px solid var(--teal);background:#e9f5f2}.notice.warning{border-color:var(--coral);background:#fff0ec}.notice.error{border-color:#a42b2b;background:#ffeded}
    .path-section{border-top:1px solid var(--line);padding:36px 0}.section-heading{display:grid;grid-template-columns:52px minmax(0,1fr);gap:16px;margin-bottom:24px}.step{width:42px;height:42px;display:grid;place-items:center;background:var(--yellow);color:#302800;font-weight:800}.section-heading h2{font-size:25px;margin:0 0 5px}.section-heading p{color:var(--muted);margin:0;line-height:1.5}
    .field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.field-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.field{display:flex;flex-direction:column;gap:7px}.field.full{grid-column:1/-1}.field label{font-weight:700;font-size:14px}.field small{color:var(--muted)}input,select,textarea{width:100%;border:1px solid #b9c3c1;background:white;color:var(--ink);padding:12px 13px;border-radius:4px;outline:none}input:focus,select:focus,textarea:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(8,127,118,.12)}textarea{resize:vertical;min-height:88px}
    .student-strip{display:none;background:#e8f1f2;border-left:5px solid var(--navy);padding:18px;margin-top:18px;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.student-strip.show{display:grid}.student-strip span{display:block;color:var(--muted);font-size:12px;text-transform:uppercase;font-weight:700}.student-strip strong{display:block;margin-top:4px;overflow-wrap:anywhere}.previous{margin-top:18px;padding:22px;background:white;border:1px solid var(--line);line-height:1.55}.previous:empty{display:none}.previous::before{content:"Previous path";display:block;color:var(--teal);font-size:11px;font-weight:800;text-transform:uppercase;margin-bottom:13px}.previous h1,.previous h2,.previous h3{font-size:18px;margin:18px 0 7px}.previous h1:first-child,.previous h2:first-child,.previous h3:first-child{margin-top:0}.previous p{margin:7px 0}.previous ol,.previous ul{padding-left:24px}.previous li{margin:8px 0}.previous blockquote{border-left:4px solid var(--yellow);margin:12px 0;padding:4px 0 4px 14px;color:var(--muted)}
    .task-list{display:grid;gap:14px}.task-row{background:white;border:1px solid var(--line);padding:18px;display:grid;grid-template-columns:1.2fr 1fr 1fr 1fr;gap:12px;position:relative}.task-number{position:absolute;top:-10px;left:14px;background:var(--coral);color:white;padding:3px 9px;font-weight:700;font-size:12px}.task-row input{padding:10px}.task-add{margin-top:14px;border:1px solid var(--teal);color:var(--teal);background:transparent;padding:10px 14px;cursor:pointer;font-weight:700}.task-remove{position:absolute;right:8px;top:7px;border:0;background:transparent;color:#8a4332;font-size:19px;cursor:pointer}
    .piece-list{display:grid;gap:20px}.piece-card{background:#fff;border:1px solid var(--line);border-top:5px solid var(--teal);padding:22px;position:relative}.piece-head{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:18px}.piece-head h3{margin:0;font-size:20px}.piece-remove{border:0;background:transparent;color:#8a4332;cursor:pointer;font-weight:700}.piece-card .task-list{margin-top:18px}.piece-knot{margin-top:18px}.piece-add{border:1px solid var(--navy);background:var(--navy);color:#fff;padding:11px 15px;margin-top:18px;cursor:pointer;font-weight:700}.piece-add:disabled{cursor:not-allowed;opacity:.45}.piece-preview{border-top:1px solid rgba(255,255,255,.24);padding-top:18px;margin-top:18px}.piece-preview:first-of-type{border-top:0;padding-top:0;margin-top:0}.piece-preview h3{margin-bottom:8px}
    details{border-top:1px solid var(--line);padding:18px 0}summary{cursor:pointer;font-weight:700;font-size:18px}.details-body{padding-top:20px}.ratings{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}.rating label{font-size:13px}.rating select{margin-top:6px}.tech-row{display:grid;grid-template-columns:2fr 1fr;gap:12px;margin-bottom:12px}
    .preview-shell{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(280px,.6fr);gap:26px}.student-preview{background:var(--navy);color:white;padding:28px;min-height:300px}.student-preview .preview-kicker{color:#9fddd4;text-transform:uppercase;font-size:12px;font-weight:700}.student-preview h3{font-family:Rye,serif;font-weight:400;font-size:28px;margin:8px 0 18px}.preview-focus{color:#dce9ed}.preview-tasks{padding-left:22px;line-height:1.5}.preview-tasks li{margin:15px 0}.preview-tasks strong,.preview-task-meta{display:block}.preview-task-meta{color:#dce9ed;font-size:13px;margin-top:3px}.preview-why{color:#f7dd82}.preview-knot{border-top:1px solid rgba(255,255,255,.25);padding-top:16px;margin-top:20px;color:#f7dd82}.publish-panel{border-top:5px solid var(--yellow);background:white;padding:22px}.email-output{display:block;min-height:45px;border:1px solid #b9c3c1;background:#f4f6f5;color:var(--ink);padding:12px 13px;border-radius:4px;overflow-wrap:anywhere}.email-output.is-empty{color:var(--muted)}.email-choice{display:flex;gap:10px;align-items:flex-start;margin:16px 0}.email-choice input{width:auto;margin-top:4px}.email-fields{display:none}.email-fields.show{display:grid;gap:14px}.submission-actions{display:grid;grid-template-columns:1fr 1.2fr;gap:10px;margin-top:18px}.draft-button,.publish-button{border:0;font-weight:800;padding:15px;cursor:pointer}.draft-button{background:#e8efed;color:var(--navy)}.publish-button{background:var(--teal);color:white;margin:0}.publish-button:hover{background:#05685f}.privacy-note{font-size:12px;color:var(--muted);line-height:1.45;margin-top:10px}
    @media(max-width:850px){.path-top-inner{align-items:flex-start;flex-direction:column}.path-nav{max-width:100%;overflow-x:auto;width:100%}.task-row{grid-template-columns:1fr 1fr}.ratings{grid-template-columns:1fr 1fr}.preview-shell{grid-template-columns:1fr}.field-grid.three{grid-template-columns:1fr}}
    @media(max-width:560px){main{padding:34px 16px 60px}.path-top-inner{padding:12px 16px}.path-nav a,.path-logout{font-size:13px;padding:7px 8px}.field-grid,.task-row,.student-strip,.ratings,.tech-row{grid-template-columns:1fr}.section-heading{grid-template-columns:42px minmax(0,1fr)}.path-title{font-size:36px}.task-row{padding-top:28px}}
  </style>
</head>
<body>
  <header class="path-top"><div class="path-top-inner"><a class="path-brand" href="/admin">Music Learning Studio</a><nav class="path-nav" aria-label="Studio administration"><a href="/admin">Studio Desk</a><a class="is-active" href="/create-week" aria-current="page">Prepare Path</a><a href="/choose-week">Path Archive</a><form action="/logout" method="POST"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="path-logout" type="submit">Log out</button></form></nav></div></header>
  <main>
    <% success.forEach(function(message) { %><div class="notice"><%= message %></div><% }) %>
    <% warnings.forEach(function(message) { %><div class="notice warning"><%= message %></div><% }) %>
    <% errors.forEach(function(message) { %><div class="notice error"><%= message %></div><% }) %>

    <form action="/create-week" method="POST" id="create-week" autocomplete="off" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="comments" id="comments">
      <input type="hidden" name="practiceTasks" id="practiceTasks">
      <input type="hidden" name="pieces" id="pieces">

      <section class="path-section">
        <div class="section-heading"><div class="step">01</div><div><h2>Choose the student</h2></div></div>
        <div class="field"><label for="student">Student</label><select required id="student" name="studentId"><option value="">Choose a student</option><% studentList.forEach(function(student) { %><option value="<%= student._id %>"><%= student.fName %> <%= student.lName %></option><% }) %></select></div>
        <div class="student-strip" id="studentStrip"><div><span>Family contact</span><strong id="contactName">Not recorded</strong></div><div><span>Email on file</span><strong id="contactEmail">Not recorded</strong></div><div><span>Published paths</span><strong id="lessonCount">0</strong></div></div>
        <div class="previous" id="lastLessonDiv"></div>
      </section>

      <section class="path-section">
        <div class="section-heading"><div class="step">02</div><div><h2>Map the music</h2></div></div>
        <div class="piece-list" id="pieceList"></div><button type="button" class="piece-add" id="addPiece">+ Add another piece</button>
      </section>

      <section class="path-section">
        <details><summary>Development snapshot</summary><div class="details-body ratings">
          <% [['rhythm','Pulse and rhythm'],['coordination','Pitch'],['tone','Articulation'],['dynamics','Dynamics'],['stylistic','Body feeling']].forEach(function(item) { %><div class="rating"><label for="<%= item[0] %>"><%= item[1] %></label><select required id="<%= item[0] %>" name="<%= item[0] %>"><option value="">Choose</option><option value="1">1 · Beginning</option><option value="2">2 · Emerging</option><option value="3">3 · Developing</option><option value="4">4 · Secure</option><option value="5">5 · Expressive</option></select></div><% }) %>
        </div></details>
        <details open><summary>Lesson-wide note (optional)</summary><div class="details-body field"><label for="generalNote">A note beyond any one piece</label><textarea id="generalNote" name="generalNote" placeholder="Technique, listening, posture, encouragement, scheduling, or anything else worth carrying into the week."></textarea><small>This appears in the student notes and family email.</small></div></details>
        <details><summary>Personal points (optional)</summary><div class="details-body field"><label for="pointsAdd">Add to this student's personal total</label><input type="number" id="pointsAdd" name="pointsAdd" min="0" value="0"></div></details>
      </section>

      <section class="path-section">
        <div class="section-heading"><div class="step">03</div><div><h2>Preview and publish</h2></div></div>
        <div class="preview-shell"><div class="student-preview"><div class="preview-kicker">Today's lesson path</div><div id="piecePreview"><p>Your pieces and practice tasks will appear here.</p></div></div>
          <aside class="publish-panel"><div class="field"><label for="familySummary">Family summary</label><textarea id="familySummary" name="familySummary" placeholder="A short note for the family. This appears only in the email."></textarea></div><div class="field"><label for="emailTo">Email to</label><output id="emailTo" class="email-output is-empty">Choose a student to fill their saved email</output></div><label class="email-choice"><input type="checkbox" id="emailToggle" name="emailParent" value="yes"><span><strong>Email this path to the family</strong></span></label><div class="email-fields" id="emailFields"><div class="field"><label for="emailSubject">Email subject</label><input id="emailSubject" name="emailSubject" value="A new practice path"></div></div><div class="submission-actions"><button class="draft-button" type="submit" name="submissionAction" value="draft">Save draft</button><button class="publish-button" type="submit" name="submissionAction" value="publish">Publish this path</button></div><div class="privacy-note">Drafts stay private in the Path Archive. Email is off by default and uses the student's saved address.</div></aside>
        </div>
      </section>
    </form>
  </main>
  <script>
    (() => {
      const form=document.querySelector('#create-week');const pieceList=document.querySelector('#pieceList');const addPieceButton=document.querySelector('#addPiece');const csrf=form.querySelector('[name="_csrf"]').value;const maxPieces=4;
      const escapeText=value=>String(value||'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[char]));
      function taskMarkup(values,index){return `<div class="task-row"><span class="task-number">TASK ${index+1}</span>${index?'<button type="button" class="task-remove" aria-label="Remove task">×</button>':''}<input data-key="task" placeholder="What to do" value="${escapeText(values.task)}"><input data-key="start" placeholder="Where to begin" value="${escapeText(values.start)}"><input data-key="why" placeholder="Why it matters" value="${escapeText(values.why)}"><input data-key="success" placeholder="Success cue" value="${escapeText(values.success)}"></div>`}
      function renumberTasks(card){[...card.querySelectorAll('.task-row')].forEach((row,index)=>{row.querySelector('.task-number').textContent=`TASK ${index+1}`;const remove=row.querySelector('.task-remove');if(remove)remove.hidden=index===0})}
      function renumber(){[...pieceList.children].forEach((card,index)=>{card.dataset.pieceIndex=index;card.querySelector('.piece-head h3').textContent=`Piece ${index+1}`;card.querySelector('.piece-remove').hidden=index===0;renumberTasks(card)});addPieceButton.disabled=pieceList.children.length>=maxPieces}
      function bindTask(row){row.querySelector('.task-remove')?.addEventListener('click',()=>{const card=row.closest('.piece-card');row.remove();renumberTasks(card);refresh()});row.querySelectorAll('input').forEach(input=>input.addEventListener('input',refresh))}
      function addTask(card,values={}){const list=card.querySelector('.task-list');if(list.children.length>=6)return;list.insertAdjacentHTML('beforeend',taskMarkup(values,list.children.length));bindTask(list.lastElementChild);renumberTasks(card);refresh()}
      function addPiece(values={}){if(pieceList.children.length>=maxPieces)return;const card=document.createElement('article');card.className='piece-card';card.innerHTML=`<div class="piece-head"><h3></h3><button class="piece-remove" type="button">Remove piece</button></div><div class="field-grid"><div class="field"><label>Piece or project</label><input data-piece-key="pieceName" placeholder="e.g. Bach Invention No. 8"></div><div class="field"><label>Lesson focus</label><input data-piece-key="lessonFocus" placeholder="e.g. Let the left hand lead the pulse"></div></div><div class="task-list"></div><button type="button" class="task-add">+ Add another task</button><div class="field piece-knot"><label>The quiet knot</label><textarea data-piece-key="quietKnot" placeholder="The one confusion worth carrying gently into the week."></textarea></div>`;card.querySelector('[data-piece-key="pieceName"]').value=values.pieceName||'';card.querySelector('[data-piece-key="lessonFocus"]').value=values.lessonFocus||'';card.querySelector('[data-piece-key="quietKnot"]').value=values.quietKnot||'';card.querySelectorAll('[data-piece-key]').forEach(input=>input.addEventListener('input',refresh));card.querySelector('.piece-remove').addEventListener('click',()=>{card.remove();renumber();refresh()});card.querySelector('.task-add').addEventListener('click',()=>addTask(card));pieceList.appendChild(card);(values.practiceTasks?.length?values.practiceTasks:[{},{},{}]).forEach(task=>addTask(card,task));renumber();refresh()}
      function pieceData(){return [...pieceList.children].map(card=>({pieceName:card.querySelector('[data-piece-key="pieceName"]').value.trim(),lessonFocus:card.querySelector('[data-piece-key="lessonFocus"]').value.trim(),quietKnot:card.querySelector('[data-piece-key="quietKnot"]').value.trim(),practiceTasks:[...card.querySelectorAll('.task-row')].map(row=>Object.fromEntries([...row.querySelectorAll('[data-key]')].map(input=>[input.dataset.key,input.value.trim()]))).filter(task=>task.task)})).filter((piece,index)=>index===0||piece.pieceName||piece.lessonFocus||piece.quietKnot||piece.practiceTasks.length)}
      function refresh(){const pieces=pieceData();const generalNote=document.querySelector('#generalNote').value.trim();document.querySelector('#pieces').value=JSON.stringify(pieces);const first=pieces[0]||{pieceName:'',lessonFocus:'',quietKnot:'',practiceTasks:[]};ensureLegacy('pieceName',first.pieceName);ensureLegacy('lessonFocus',first.lessonFocus);ensureLegacy('quietKnot',first.quietKnot);document.querySelector('#practiceTasks').value=JSON.stringify(first.practiceTasks);const lines=[];pieces.forEach(piece=>{if(piece.pieceName)lines.push(`# ${piece.pieceName}`);if(piece.lessonFocus)lines.push(`## Focus\n${piece.lessonFocus}`);if(piece.practiceTasks.length){lines.push('## Practice Path');piece.practiceTasks.forEach((task,index)=>lines.push(`${index+1}. **${task.task}**${task.start?`\n\n   **Begin at:** ${task.start}`:''}${task.why?`\n\n   **Why:** ${task.why}`:''}${task.success?`\n\n   **Success cue:** ${task.success}`:''}`))}if(piece.quietKnot)lines.push(`## The Quiet Knot\n> ${piece.quietKnot}`)});if(generalNote)lines.push(`## Lesson-wide Note\n${generalNote}`);document.querySelector('#comments').value=lines.join('\n\n');document.querySelector('#piecePreview').innerHTML=pieces.filter(piece=>piece.pieceName||piece.practiceTasks.length).map(piece=>`<section class="piece-preview"><h3>${escapeText(piece.pieceName||'Untitled piece')}</h3><p class="preview-focus">${escapeText(piece.lessonFocus||'No focus recorded yet.')}</p><ol class="preview-tasks">${piece.practiceTasks.length?piece.practiceTasks.map(task=>`<li><strong>${escapeText(task.task)}</strong>${task.start?`<span class="preview-task-meta">Begin at: ${escapeText(task.start)}</span>`:''}${task.why?`<span class="preview-task-meta preview-why">Why: ${escapeText(task.why)}</span>`:''}${task.success?`<span class="preview-task-meta">Success cue: ${escapeText(task.success)}</span>`:''}</li>`).join(''):'<li>No practice tasks yet.</li>'}</ol>${piece.quietKnot?`<div class="preview-knot">The quiet knot: ${escapeText(piece.quietKnot)}</div>`:''}</section>`).join('')||'<p>Your pieces and practice tasks will appear here.</p>';if(generalNote)document.querySelector('#piecePreview').insertAdjacentHTML('beforeend',`<div class="preview-knot"><strong>Lesson-wide note</strong><br>${escapeText(generalNote)}</div>`)}
      function ensureLegacy(name,value){let input=form.querySelector(`[name="${name}"]`);if(!input){input=document.createElement('input');input.type='hidden';input.name=name;form.appendChild(input)}input.value=value}
      addPieceButton.addEventListener('click',()=>addPiece());document.querySelector('#generalNote').addEventListener('input',refresh);addPiece();
      const toggle=document.querySelector('#emailToggle');toggle.addEventListener('change',()=>document.querySelector('#emailFields').classList.toggle('show',toggle.checked));
      document.querySelector('#student').addEventListener('change',async event=>{const id=event.target.value;document.querySelector('#studentStrip').classList.remove('show');document.querySelector('#lastLessonDiv').innerHTML='';document.querySelector('#emailTo').textContent='Choose a student to fill their saved email';document.querySelector('#emailTo').classList.add('is-empty');toggle.checked=false;toggle.disabled=true;document.querySelector('#emailFields').classList.remove('show');if(!id)return;try{const response=await fetch('/getStudentData',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({_csrf:csrf,studentId:id})});const data=await response.json();const student=data.student||{};document.querySelector('#contactName').textContent=student.parentName||'Not recorded';document.querySelector('#contactEmail').textContent=student.email||'Not recorded';document.querySelector('#lessonCount').textContent=student.lessonCount||0;document.querySelector('#studentStrip').classList.add('show');document.querySelector('#lastLessonDiv').innerHTML=data.lastLessonHTML||'';document.querySelector('#emailTo').textContent=student.email||'No family email is recorded';document.querySelector('#emailTo').classList.toggle('is-empty',!student.email);toggle.disabled=!student.email;document.querySelector('#emailSubject').value=`A new practice path for ${student.fName||'your student'}`;}catch(err){console.error('Student details could not be loaded:',err);document.querySelector('#emailTo').textContent='Contact details could not be loaded';document.querySelector('#emailTo').classList.add('is-empty');}});
      form.addEventListener('submit',event=>{refresh();const publishing=event.submitter?.value==='publish';const pieces=pieceData();const required=publishing?[...form.querySelectorAll('[required]')]:[document.querySelector('#student')];const missing=required.filter(field=>!String(field.value||'').trim());pieceList.querySelectorAll('[aria-invalid="true"]').forEach(field=>field.removeAttribute('aria-invalid'));if(publishing)pieces.forEach((piece,index)=>{const card=pieceList.children[index];if(!piece.pieceName){const field=card.querySelector('[data-piece-key="pieceName"]');field.setAttribute('aria-invalid','true');missing.push(field)}if(!piece.practiceTasks.length){const field=card.querySelector('[data-key="task"]');field.setAttribute('aria-invalid','true');missing.push(field)}});if(missing.length){event.preventDefault();alert(publishing?'Before publishing, choose a student, complete the snapshot, and give every piece a name and at least one practice task.':'Choose a student before saving this draft.');missing[0].closest('details')?.setAttribute('open','');missing[0].focus();missing[0].scrollIntoView({behavior:'smooth',block:'center'})}});
    })();
  </script>
</body>
</html>
